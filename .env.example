# AnyMail
# 需要的 scope：emails:read + accounts:write（没固定域名时再加 domains:read），
# 且 API Key 必须限定账号类型为 Domain，否则无法通过接口建邮箱。
ANYMAIL_BASE_URL=https://your-any-mail.example.com
ANYMAIL_API_KEY=ak_xxxxxxxx

# 可选：固定后缀域名。不填则从 /api/domains 拉列表让你选（只有一个域名时直接用）
# ANYMAIL_DOMAIN=mail.example.com

# 可选：邮箱有效期小时数。留空/0/负数=永久（默认，不传 expires_at）；正数=该值
# 注意：设了正数小时后，到期 AnyMail 的 cron 会把邮箱连同邮件一起删除，
# 注册出来的账号之后就收不了信（改密码、设备验证）。默认永久即可。
# ANYMAIL_EXPIRES_HOURS=0

# 可选：覆盖 6 位验证码的提取正则（兜底路径用，默认路径是魔术链接）。
# 建议带捕获组并要求 code 字样，避免把邮件 HTML 里的日期或 CSS 颜色值当成验证码。
# ANYMAIL_CODE_REGEX=code[^\d]*(\d{6})

# 可选：跳过浏览器结束时的暂停（管道/非交互运行时有用）
# CLAUDE_REGISTER_NO_PAUSE=1
